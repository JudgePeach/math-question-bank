# ==========================================
# 本地数学题库管理系统 - 环境变量配置模版
# 使用方法：复制本文件并重命名为 .env，然后填写对应 API 密钥
# ==========================================

# --- 可选的社区 QA 工作区 ---
# 可选 QA 工作区默认开启；仅本机不需要时在 .env 设置为 0 并重启。
MATHBANK_QA_ENABLED=1

# --- OCR 图像识别引擎偏好配置 ---
# 可选值：
# - ali_bailian (阿里百炼，首选推荐，速度最快且公式识别准确)
# - siliconflow (硅基流动，调用 Qwen 视觉语言模型)
# - deepseek (DeepSeek Flash，原生多模态识图)
OCR_PREFER_ENGINE=ali_bailian

# 1. 阿里百炼 OCR (阿里云大模型)
# 请在阿里云百炼控制台获取 API Key
ALI_BAILIAN_API_KEY=your_ali_bailian_api_key_here
ALI_BAILIAN_OCR_MODEL=qwen3.7-flash

# 2. SiliconFlow OCR (硅基流动)
# 请通过专属邀请链接注册并获取 API Key：https://cloud.siliconflow.cn/i/hkgjSWrg
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
# 模型可选择：
# - Qwen/Qwen3-VL-8B-Instruct (推荐，正常够用，性价比较高)
# - Qwen/Qwen3-VL-32B-Instruct (双倍价格但效果更好)
SILICONFLOW_OCR_MODEL=Qwen/Qwen3-VL-8B-Instruct

# PDF 首次逐页识图总并发：默认4，可设1至12；更改后重启生效。
# 单题识图和原页核验仍最多4路，并与PDF识图共享总名额。
PDF_OCR_CONCURRENCY=4

# --- 大模型 AI 推理与解析配置 ---
# DeepSeek API 密钥
# 请在 https://platform.deepseek.com/ 获取 API Key
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DeepSeek 官方识图使用 Flash；V4 Pro 不支持图片输入
DEEPSEEK_OCR_MODEL=deepseek-flash

# AI 答题与解析模型指定
# 支持配置如 deepseek-flash (DeepSeek Flash，支持图像输入), deepseek-v4-pro, qwen3.7-plus 等
PREFER_SOLVE_MODEL=deepseek-v4-pro
PREFER_PARSE_MODEL=deepseek-flash

# AI 请求等待上限（秒）；修改后重启服务生效，允许60至7200。
# 普通AI：分类、解答、单题识图、绘图、选题、错误解释。
MATHBANK_AI_REQUEST_TIMEOUT_SECONDS=900
# 文档AI：逐页识图、拆卷、来源核验和修复。
MATHBANK_DOCUMENT_AI_TIMEOUT_SECONDS=1800

# --- 常用处理容量（保持原默认；修改后重启生效） ---
# MB项按MiB计算；仅接受范围内整数，无效值回原默认，不关闭安全校验。
MATHBANK_MAX_IMAGE_MIB=10
MATHBANK_MAX_IMAGE_MEGAPIXELS=30
MATHBANK_MAX_NORMALIZED_IMAGE_MIB=20
MATHBANK_MAX_DOCUMENT_MIB=30
MATHBANK_MAX_TEXT_SOURCE_MIB=5
MATHBANK_MAX_PDF_PAGES=80
MATHBANK_DOCUMENT_WORKERS=2
MATHBANK_DOCUMENT_QUEUE=4
MATHBANK_CLASSIFY_MAX_IMAGES=4
MATHBANK_CLASSIFY_IMAGE_MIB=4
# PDF_OCR_CONCURRENCY在上方配置；主路由与辅助核验共享实际总名额。

# 分类质量可在设置界面保存；quick保持原快速策略，precise按需增加预算。
# 仅已验证模型协议会开启思考，未知中转不猜测参数；不自动修改历史标注。
MATHBANK_CLASSIFY_MODE=quick
MATHBANK_CLASSIFY_QUICK_MAX_TOKENS=4096
MATHBANK_CLASSIFY_PRECISE_MAX_TOKENS=8192
