# ==========================================
# 本地数学题库管理系统 - Git 忽略配置
# ==========================================

# 1. 忽略本地环境变量文件（内含敏感 API Keys 和 Tokens，绝对不能公开）
.env
.env.*
# 仅保留项目根目录中不含真实密钥的配置模板
!/.env.example
*.env.local

# 2. 忽略本地 SQLite 数据库文件、日志文件及临时测试数据库备份
*.db
*.db-journal
*.db-shm
*.db-wal
*.db.*
*.failed_attempt
*.log

# 3. 忽略本地备份目录下的所有数据备份与导出只读题库
# 但通过排除 .gitkeep，使得 data_backup 目录结构可以被提交到 GitHub 上
data_backup/*
!data_backup/.gitkeep
!data_backup/archive/
data_backup/archive/*
!data_backup/archive/.gitkeep

# 4. 忽略用户上传的插图资源
# 但通过排除 .gitkeep，使得 static/uploads 目录结构可以被提交到 GitHub 上
static/uploads/*
!static/uploads/.gitkeep
# 本机静态目录副本包含用户插图，只在本地保留。
/static_副本/

# 5. 忽略 Python 运行缓存、测试缓存及本地临时草稿代码目录
.system_generated/
/restored_content_sources/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.pytest/
scratch/

# 6. 忽略操作系统临时文件与 IDE 配置文件
.DS_Store
.localized
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# 7. 忽略 Python 虚拟环境与本地构建输出目录
dist/
build/
venv/
.venv/
env/
*.spec

# 8. 忽略打包构建缓存与 Release 导出包
.build_cache/
Release_Output/

# 9. 忽略组卷导出的本地 PDF 与 ZIP 归档文件（防误保存至项目目录）
*.pdf
# 固定的非用户PDF字形证据fixture；tests仍由发布包统一排除。
!/tests/fixtures/pdf_source_scopes/supported_cm_script.pdf
*.zip
*.tar.gz

# 10. 忽略开发测试产生的临时调试图片与测试产物
*_test.png
*_cropped.png
test_*.png
*_comparison*.png
static/test_uploads/
tests/artifacts/*
!tests/artifacts/.gitkeep

# 11. 忽略 LaTeX 引擎本地编译产生的临时日志与中间产物
*.aux
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
*.xdv
*.bbl
*.blg

# 12. 内部计划与维护文档只在本地保留
# 公开保留 AI 题库检索指南及 README 使用的图片资源
/docs/*
!/docs/AI_DATABASE_GUIDE.md
!/docs/images/

# 13. 本机批量处理工具及专用测试，不属于公开题库功能
# 精确限定路径；正常运行模块、教材资源和产品回归测试继续跟踪
/mathbank/association_batch.py
/mathbank/classification_proposals.py
/mathbank/difficulty_batch.py
/mathbank/knowledge_backfill.py
/mathbank/knowledge_backfill_apply.py
/mathbank/question_exchange.py
/scripts/association_batch.py
/scripts/backfill_question_references.py
/scripts/classification_proposals.py
/scripts/difficulty_batch.py
/scripts/difficulty_classify.py
/scripts/knowledge_backfill.py
/scripts/knowledge_backfill_apply.py
/scripts/question_exchange.py
/scripts/resources/
/tests/test_association_batch.py
/tests/test_backfill_question_references.py
/tests/test_question_references_exchange.py
/tests/test_classification_proposals.py
/tests/test_difficulty_batch.py
/tests/test_knowledge_backfill.py
/tests/test_knowledge_backfill_apply.py
/tests/test_question_exchange.py
/scripts/migrate_word_math_private_chars.py
/tests/test_migrate_word_math_private_chars.py
